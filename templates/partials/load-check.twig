{# Fails the build if a PHP extension can't be loaded. Shared by templates Dockerfile.twig and Dockerfile.alpine.twig. #}
# Fail the build if the extension does not actually load. Swoole is compiled here for every target platform, and
# a library that is missing at runtime (rather than at link time) produces a successful build but an image
# whose Swoole extension cannot be loaded at all. PHP only warns about that and still exits 0, so it has to
# be asserted explicitly; the published ppc64le and s390x Alpine images shipped broken this way. The PECL extensions
# are checked too, since removing the build-only packages could take a runtime library of theirs along.
    php -r 'exit(extension_loaded("swoole"){% for name, data in php_extensions %}{% if data.enabled %} && extension_loaded("{{ name }}"){% endif %}{% endfor %} ? 0 : 1);' && \
# Loading the extension doesn't prove that coroutines work: on the platforms Swoole has no context-switching assembly
# for (e.g., ppc64le and s390x), they switch through the ucontext functions, which nothing else in the build exercises,
# and the functional tests only run on the platforms native to their runners. So switch between two coroutines for
# real{% if php_extensions.igbinary.enabled|default(false) %}, passing a value through extension igbinary on the way (s390x is the only big-endian platform, and
# nothing else serializes anything there){% endif %}.
    php -r '$ok = false; Swoole\Coroutine\run(function () use (&$ok) { $channel = new Swoole\Coroutine\Channel(1); Swoole\Coroutine::create(function () use ($channel) { Swoole\Coroutine::sleep(0.01); $channel->push({% if php_extensions.igbinary.enabled|default(false) %}igbinary_unserialize(igbinary_serialize(["swoole" => 1])){% else %}["swoole" => 1]{% endif %}); }); $ok = $channel->pop(10) === ["swoole" => 1]; }); exit($ok ? 0 : 1);'
